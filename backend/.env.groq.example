# Windows verification profile. Copy to backend/.env and enter your Groq key.
# Put the same key in BOTH fields; dotenv interpolation is intentionally not required.
PORT=5050
DB_PATH=tutor.db
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
GROQ_API_KEY=
LLM_JSON_MODE=json_schema
LLM_EXTRA_JSON={"reasoning_effort":"low"}
LLM_TEMPERATURE=0.2
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1
TTS_PROVIDER=edge
EDGE_VOICE_EN=en-US-AndrewNeural
EDGE_VOICE_DE=de-DE-ConradNeural
