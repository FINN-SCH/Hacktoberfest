# Copy to backend/.env. Environment variables override this file. Never commit secrets.
PORT=5050
DB_PATH=tutor.db
PROVIDER_TIMEOUT_S=60
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=qwen3.8-fast
LLM_API_KEY=dummy
LLM_JSON_MODE=prompt
# Merged VERBATIM into the HTTP request body. The literal extra_body wrapper matches
# Klabundo's raw httpx prototype, unlike an SDK that flattens its extra_body argument.
# If his proxy requires flattened arguments, change this to {"chat_template_kwargs":{"enable_thinking":false}}.
LLM_EXTRA_JSON={"extra_body":{"chat_template_kwargs":{"enable_thinking":false}}}
LLM_TEMPERATURE=0.2
LLM_TURN_MAX_TOKENS=2048
LLM_REPORT_MAX_TOKENS=2048
LLM_QUIZ_MAX_TOKENS=4096
LLM_ANALYSIS_MAX_TOKENS=2048
STT_PROVIDER=faster_whisper
STT_MODEL=large-v3-turbo
STT_DEVICE=auto
STT_CPU_THREADS=6
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
TTS_PROVIDER=edge
EDGE_VOICE_EN=en-US-AndrewNeural
# Microsoft documents this German voice; check the live Edge voice list during setup:
# python -m edge_tts --list-voices
EDGE_VOICE_DE=de-DE-ConradNeural
EDGE_RATE=+2%
EDGE_VOLUME=+4%
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/inference
TTS_MODEL=ResembleAI/chatterbox-multilingual
# Optional custom DeepInfra voice IDs, not Edge voice names:
# DEEPINFRA_VOICE_EN=
# DEEPINFRA_VOICE_DE=
