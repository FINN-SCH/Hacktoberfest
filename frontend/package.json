{
  "name": "voice-language-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "postinstall": "node scripts/copy-vad-assets.mjs",
    "build": "node scripts/copy-vad-assets.mjs && tsc -b && vite build",
